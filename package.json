{
  "name": "teamham.world",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --experimental-https",
    "dev:vps": "bash scripts/dev-vps-local.sh",
    "storage:local": "bash scripts/start-local-s3.sh",
    "storage:local:verify": "NODE_EXTRA_CA_CERTS=certificates/rootCA.pem node scripts/verify-local-s3.mjs",
    "storage:local:stop": "docker compose -f infra/local-s3/compose.yaml stop minio",
    "prebuild": "npm run preflight",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "preflight": "node --import tsx scripts/preflight.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:integration:vps": "bash scripts/test-integration-vps.sh",
    "test:e2e": "playwright test",
    "test:e2e:vps": "bash scripts/e2e/run-e2e-vps.sh",
    "test:e2e:browsers": "playwright install chromium"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.1.0",
    "@tiptap/core": "^3.30.3",
    "@tiptap/extension-link": "^3.30.3",
    "@tiptap/react": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "aws4fetch": "^1.0.20",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
